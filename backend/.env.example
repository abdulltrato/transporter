JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
OTP_TTL_SECONDS=300
OTP_DEV_MODE=true
OTP_REQUEST_COOLDOWN_SECONDS=30
OTP_REQUEST_WINDOW_SECONDS=300
OTP_MAX_REQUESTS_PER_WINDOW=5
AGENT_VALIDATION_KEY=change_me_agent_key
DATABASE_URL=postgres://postgres:postgres@localhost:5433/transporter
# Opcional (se nao usar DATABASE_URL):
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=transporter
REDIS_URL=redis://localhost:6379
# Opcional (se nao usar REDIS_URL):
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# LOCATION_TTL_SECONDS=1800
